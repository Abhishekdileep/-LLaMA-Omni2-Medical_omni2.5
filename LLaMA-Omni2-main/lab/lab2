def column_stats(X):
    """
    Return mean, standard deviation, minimum and maximum
    for each column of a 2-D array.
    """
    mean = X.mean(axis=0)
    std = X.std(axis=0)
    minimum = X.min(axis=0)
    maximum = X.max(axis=0)

    return mean, std, minimum, maximum

