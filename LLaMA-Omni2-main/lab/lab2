def pairwise_distances(A, B):
    """
    Return the Euclidean distance between every row of A
    and every row of B.
    """
    differences = A[:, np.newaxis, :] - B[np.newaxis, :, :]
    distances = np.sqrt(np.sum(differences ** 2, axis=2))

    return distances

A = np.array([
    [0, 0],
    [3, 4],
    [1, 1]
])

B = np.array([
    [0, 0],
    [3, 4]
])

D = pairwise_distances(A, B)

print("Distance matrix:\n", D)
print("Shape:", D.shape)

def pairwise_distances_naive(A, B):
    n = A.shape[0]
    m = B.shape[0]

    D = np.zeros((n, m))

    for i in range(n):
        for j in range(m):
            D[i, j] = np.sqrt(np.sum((A[i] - B[j]) ** 2))

    return D

D_vectorized = pairwise_distances(A, B)
D_naive = pairwise_distances_naive(A, B)

print("Vectorized result:\n", D_vectorized)

print("\nNaive result:\n", D_naive)

print("\nResults match:", np.allclose(D_vectorized, D_naive))

