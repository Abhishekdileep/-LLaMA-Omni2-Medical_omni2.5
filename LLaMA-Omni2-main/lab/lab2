def mask_values(X, t):
    """
    Replace values greater than t with t in a copy of X
    and return the row-wise count of values greater than t.
    """
    X_copy = X.copy()

    mask = X_copy > t
    X_copy[mask] = t

    row_counts = mask.sum(axis=1)

    return X_copy, row_counts

